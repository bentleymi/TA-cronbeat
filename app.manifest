{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Scheduled Job Heartbeat Add-on (systemd timers, cron)",
    "id": {
      "group": null,
      "name": "TA-cronbeat",
      "version": "1.0.10"
    },
    "author": [
      {
        "name": "Michael \"JKat54\" Bentley",
        "email": "michael@bentleypc.com",
        "company": "BentleyPC LLC"
      }
    ],
    "releaseDate": "11/16/2026",
    "description": "Collects scheduled-job heartbeat data: all systemd timers (next elapsed, last elapsed, last-run timestamps) via systemctl list-timers, plus a count of cron jobs from /etc/crontab and /etc/cron.d. Emits JSON events to index=main (sourcetype cronbeat:status) and cronbeat.* metrics (timer totals, stale timers, cron job count) to index=metrics (sourcetype cronbeat:metrics), with dashboards.",
